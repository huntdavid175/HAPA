# Copy to .env.local and fill in. Every value here is validated at boot by lib/env.ts —
# a missing or malformed value crashes the server immediately rather than at 8pm on
# event night.

# --- Site ---------------------------------------------------------------------------
# Used to build ticket links that go out over SMS/WhatsApp. Must be the public origin,
# no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase -----------------------------------------------------------------------
# Dashboard → Project Settings → API Keys.
# These are the current key types. The legacy `anon` / `service_role` JWTs are deprecated
# (Supabase is removing them by end of 2026) and are rejected by lib/env.ts on purpose.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Safe in the browser. Authenticates as the `anon` Postgres role, so RLS applies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Server-only. Authenticates as `service_role` and bypasses RLS entirely —
# never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Paystack (Ghana, GHS) ----------------------------------------------------------
# Test keys in local + preview. Live keys only in production.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Cron ---------------------------------------------------------------------------
# Shared secret for the hold-expiry sweeper and the delivery worker. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- Messaging ----------------------------------------------------------------------
# "stub" writes to message_deliveries and sends nothing — use it until the Moolre
# contract is confirmed. "moolre" requires every MOOLRE_* value below.
MESSAGING_PROVIDER=stub

# MOOLRE_API_URL=
# MOOLRE_API_USER=
# MOOLRE_API_KEY=
# MOOLRE_ACCOUNT_NUMBER=
# MOOLRE_SENDER_ID=

# --- Observability ------------------------------------------------------------------
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
