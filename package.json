{
  "name": "tickets",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "seed": "node --env-file=.env.local scripts/seed.mts",
    "check:auth": "node --env-file=.env.local scripts/check-auth.mts",
    "check:datetime": "node scripts/check-datetime.mts",
    "check:broadcast": "node --env-file=.env.local scripts/check-broadcast.mts",
    "check:gate": "node --env-file=.env.local scripts/check-gate.mts",
    "check": "npm run typecheck && npm run check:datetime && npm run check:phone && npm run check:auth && npm run check:broadcast && npm run check:gate && npm run check:checkout && npm run check:orders",
    "check:checkout": "node --env-file=.env.local scripts/check-checkout.mts",
    "check:phone": "node scripts/check-phone.mts",
    "check:webhook": "node --env-file=.env.local scripts/check-webhook.mts",
    "check:orders": "node --env-file=.env.local scripts/check-orders.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
